{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: watch",
      "type": "shell",
      "command": "./node_modules/.bin/tsc -p . --watch --preserveWatchOutput",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "serve: python",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP on",
          "endsPattern": "Serving HTTP on"
        }
      }
    },
    {
      "label": "dev: watch+serve",
      "dependsOn": [
        "tsc: watch",
        "serve: python"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
