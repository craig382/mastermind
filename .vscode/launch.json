{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch in Brave (serve + debug)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:8080/index.html",
            "runtimeExecutable": "/usr/bin/brave",
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ],
            "webRoot": "${workspaceFolder}",
            "sourceMaps": false,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "preLaunchTask": "npm: serve"
        }
    ]
}
